# Supabase configuration — set these in your Vercel project env vars.
# Frontend (exposed to the browser — safe, public keys only):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The app reads the publishable key name; paste your anon/publishable key value here:
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only (SSR + server functions — never exposed to the browser):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
