# Supabase configuration — copy these into your Vercel project env vars.
# Frontend (exposed to the browser — safe, public keys only):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Either name works; the app accepts both (anon key is aliased automatically):
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (SSR + server functions — never exposed to the browser):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
